{
  "name": "mono_auth",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.11.0"
    }
  },
  "engines": {
    "node": ">=18",
    "npm": ">=11.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
